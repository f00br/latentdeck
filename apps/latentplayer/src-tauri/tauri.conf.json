{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LatentPlayer",
  "version": "0.1.0",
  "identifier": "studio.latentdeck.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LatentPlayer",
        "width": 960,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
