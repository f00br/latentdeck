{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentdeck.org/schema/operator-explicit-install/0.1.0",
  "title": "LatentDeck Explicit-Install Operator Descriptor 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operator_id",
    "operator_version",
    "trust",
    "entrypoint",
    "topology",
    "input_count",
    "capabilities",
    "supported_profiles",
    "controls",
    "bypass",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "operator_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "operator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "trust": { "const": "explicit_install" },
    "entrypoint": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "topology": {
      "enum": ["single_source", "dual_source", "carrier_donors"]
    },
    "input_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_clip", "streaming", "chunk", "deterministic"],
      "properties": {
        "full_clip": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "chunk": { "type": "boolean" },
        "deterministic": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "full_clip": { "const": true } } },
        { "properties": { "streaming": { "const": true } } },
        { "properties": { "chunk": { "const": true } } }
      ]
    },
    "supported_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codec_family",
          "profile",
          "profile_version",
          "timing_contract",
          "timing_contract_version",
          "layout",
          "runtime_dtype"
        ],
        "properties": {
          "codec_family": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "profile": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "profile_version": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "timing_contract": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "timing_contract_version": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "layout": { "const": "[1,24,1,H,W]" },
          "runtime_dtype": { "const": "F16" }
        }
      }
    },
    "controls": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "default", "values"],
            "properties": {
              "type": { "const": "enum" },
              "default": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "default", "minimum", "maximum"],
            "properties": {
              "type": { "const": "float" },
              "default": { "type": "number" },
              "minimum": { "type": "number" },
              "maximum": { "type": "number" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "default", "minimum", "maximum"],
            "properties": {
              "type": { "const": "integer" },
              "default": { "type": "integer" },
              "minimum": { "type": "integer" },
              "maximum": { "type": "integer" }
            }
          }
        ]
      }
    },
    "bypass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controls", "output_source"],
      "properties": {
        "controls": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              { "type": "number" }
            ]
          }
        },
        "output_source": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_spatial_tokens"],
      "properties": {
        "max_spatial_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "topology": { "const": "single_source" } } },
      "then": { "properties": { "input_count": { "const": 1 } } }
    },
    {
      "if": { "properties": { "topology": { "const": "dual_source" } } },
      "then": { "properties": { "input_count": { "const": 2 } } }
    },
    {
      "if": { "properties": { "topology": { "const": "carrier_donors" } } },
      "then": { "properties": { "input_count": { "minimum": 2 } } }
    }
  ]
}
