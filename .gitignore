target/
**/target/
**/src-tauri/gen/

# JavaScript / Svelte / Vite
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.svelte-kit/
**/.svelte-check/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Python / uv / pytest
.venv/
venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases and indexes
*.sqlite
*.sqlite3
*.db

# Latent cartridges, model assets, and ML checkpoints are never public by default
*.lc
*.partial
*.lc.partial
*.h3latent
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.engine
*.plan
*.gguf
*.bin

# Generated media and opaque archives require an explicit public-assets review
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.flac
*.mp3
*.zip
*.7z
*.rar
*.tar
*.tgz
*.gz

# Local research material and generated outputs
/artifacts/
/benchmarks/raw/
/cartridges/
/checkpoints/
/data/
/datasets/
/models/
/outputs/
/private/
/.private/
/scratch/
/tmp/
/.tools/
/vendor-local/
**/weights/

# Owner-authorized, project-local generated UI sketches are visual references
# only. Public builds use original screenshots of implemented applications.
/docs/assets/concepts/*.png

# Tauri's icon generator also emits mobile/macOS/raster variants. The Windows
# 0.1 source tree tracks only the original SVG and required ICO resource.
/apps/*/src-tauri/icons/android/
/apps/*/src-tauri/icons/ios/
/apps/*/src-tauri/icons/*.png
/apps/*/src-tauri/icons/*.icns

# Package-manager caches (lock files remain tracked)
.pnpm-store/
.npm/
.yarn/
.uv-cache/

# Windows build products and installers are release artifacts, not source
*.exe
*.dll
*.pdb
*.msi
*.msix
*.appx
