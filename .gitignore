# Owner-supplied UI sketches are local-only visual references. Public builds
# must use original screenshots of the implemented applications instead.
/docs/assets/concepts/*.png

# Package-manager caches (lock files remain tracked)
.pnpm-store/
.npm/
.yarn/
.uv-cache/

# Windows build products and installers are release artifacts, not source
*.exe
*.dll
*.msi
*.msix
*.appx
