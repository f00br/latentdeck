{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/f00br/latentdeck/main/spec/codec-pack/codec-pack.schema.json",
  "title": "LatentDeck Codec Package Manifest 2.0",
  "description": "Machine-readable shape for codec-pack.json. Runtime, importability, hash, compatibility, path, and closed-tree checks remain authoritative in latentdeck-extension-manager and the Codec Host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "kind",
    "pack_id",
    "pack_version",
    "display_name",
    "summary",
    "publisher",
    "license",
    "platform",
    "compatibility",
    "adapter",
    "worker",
    "capabilities",
    "external_assets",
    "runtime_lock",
    "integrity"
  ],
  "properties": {
    "manifest_version": { "const": "2.0.0" },
    "kind": { "const": "codec_pack" },
    "pack_id": { "$ref": "#/$defs/reverseDns" },
    "pack_version": { "$ref": "#/$defs/packageVersion" },
    "display_name": { "$ref": "#/$defs/displayText" },
    "summary": { "$ref": "#/$defs/summaryText" },
    "publisher": { "$ref": "#/$defs/publisher" },
    "license": { "$ref": "#/$defs/license" },
    "platform": { "$ref": "#/$defs/platform" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "worker": { "$ref": "#/$defs/worker" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "external_assets": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/externalAsset" } },
    "runtime_lock": { "$ref": "#/$defs/runtimeLock" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "packageVersion": {
      "type": "string",
      "maxLength": 115,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9a-z-]*[a-z-][0-9a-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9a-z-]*[a-z-][0-9a-z-]*)))*)?(?:\\+[0-9a-z-]+(?:\\.[0-9a-z-]+)*)?$"
    },
    "reverseDns": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9_-]+$"
    },
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "summaryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[ -~]+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "httpsUrlOrNull": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 500, "pattern": "^https://" }
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "identity_claim"],
      "properties": {
        "name": { "$ref": "#/$defs/displayText" },
        "url": { "$ref": "#/$defs/httpsUrlOrNull" },
        "identity_claim": { "const": "self_declared" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_or_label", "notice_path"],
      "properties": {
        "spdx_or_label": { "$ref": "#/$defs/displayText" },
        "notice_path": { "$ref": "#/$defs/portablePath" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "const": "windows" },
        "arch": { "const": "x86_64" }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "platform_tag"],
      "properties": {
        "implementation": { "const": "cpython" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "platform_tag": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec_family", "profile", "profile_version"],
      "properties": {
        "codec_family": { "$ref": "#/$defs/localId" },
        "profile": { "$ref": "#/$defs/localId" },
        "profile_version": { "$ref": "#/$defs/semver" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_min_inclusive",
        "app_max_exclusive",
        "worker_protocol",
        "codec_adapter_api",
        "tensor_abi",
        "python",
        "torch_exact_build",
        "lc_spec_versions",
        "profiles"
      ],
      "properties": {
        "app_min_inclusive": { "$ref": "#/$defs/semver" },
        "app_max_exclusive": { "$ref": "#/$defs/semver" },
        "worker_protocol": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "codec_adapter_api": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tensor_abi": { "type": "string", "minLength": 1, "maxLength": 128 },
        "python": { "$ref": "#/$defs/python" },
        "torch_exact_build": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lc_spec_versions": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/semver" } },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/profile" } }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "entrypoint"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/reverseDns" },
        "adapter_version": { "$ref": "#/$defs/semver" },
        "entrypoint": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*:[A-Za-z0-9_]+$" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "working_directory", "start_timeout_ms", "heartbeat_timeout_ms"],
      "properties": {
        "executable": { "$ref": "#/$defs/portablePath" },
        "arguments": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000\\r\\n]*$" } },
        "working_directory": { "$ref": "#/$defs/portablePath" },
        "start_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "heartbeat_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 }
      }
    },
    "capability": {
      "enum": ["player", "realtime", "resample", "snapshot_capture", "live_capture", "raw_import"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" },
      "allOf": [
        { "contains": { "const": "player" } },
        { "contains": { "const": "realtime" } },
        { "contains": { "const": "resample" } },
        { "contains": { "const": "snapshot_capture" } },
        { "contains": { "const": "live_capture" } }
      ]
    },
    "externalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "display_name", "required", "byte_length", "sha256", "source_url", "license_label", "license_url"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/localId" },
        "display_name": { "$ref": "#/$defs/displayText" },
        "required": { "type": "boolean" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "$ref": "#/$defs/httpsUrlOrNull" },
        "license_label": { "$ref": "#/$defs/displayText" },
        "license_url": { "$ref": "#/$defs/httpsUrlOrNull" }
      }
    },
    "runtimeLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_path", "catalog_sha256"],
      "properties": {
        "catalog_path": { "const": "integrity.json" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
